rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      // Temporarily allow all for prototyping until Auth is enabled in the console
      return true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---

    function isValidGame(data) {
      return data.keys().hasAll(['state', 'currentRound', 'conditionalId', 'updatedAt'])
        && data.keys().size() <= 6
        && data.state in ['lobby', 'round_active', 'round_evaluating', 'round_discussion', 'end']
        && data.currentRound is int
        && data.conditionalId is string
        && data.updatedAt == request.time;
    }

    function isValidPlayer(data) {
      return data.keys().hasAll(['present', 'score', 'exp', 'rank', 'updatedAt'])
        && data.keys().size() <= 6
        && data.present is bool
        && data.score is int
        && data.exp is int
        && data.rank is string && data.rank.size() <= 100
        && data.updatedAt == request.time;
    }

    function isValidSubmission(data) {
      return data.keys().hasAll(['roundId', 'playerId', 'updatedAt'])
        && data.keys().size() >= 4
        && data.roundId is int
        && data.playerId is string
        && data.updatedAt == request.time;
    }

    function isValidEvaluation(data) {
      return data.keys().hasAll(['score'])
        && data.updatedAt == request.time;
    }

    // --- Collection Routes ---

    match /games/{gameId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(gameId) && isValidGame(incoming());
      allow update: if isSignedIn() && (
        // Professor access (conceptually)
        isValidGame(incoming())
      );
      allow delete: if false; // Prevention of accidental game deletion

      match /players/{playerId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && isValidId(playerId) && isValidPlayer(incoming());
        // In a real app: && playerId == request.auth.uid (but here players use manual IDs)
      }

      match /submissions/{submissionId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && isValidId(submissionId) && isValidSubmission(incoming());
      }

      match /evaluations/{evaluationId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && isValidId(evaluationId) && isValidEvaluation(incoming());
      }
    }
  }
}
